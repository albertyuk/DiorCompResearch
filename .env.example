# Maison Monitor — secrets. Copy to .env and fill in. Never commit .env.

# TikHub — create/copy at https://user.tikhub.io → API Keys.
# Note: TikHub shows a key only once, at creation — if you didn't save yours, generate a new one.
TIKHUB_API_KEY=

# Anthropic — https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=

# Optional — model for the filter/match/consolidate/describe calls (this is the default)
# MM_MODEL=claude-sonnet-5

# ── Hosted Console (Fly.io) ──────────────────────────────────────────────
# Team passphrase for the Console login page. Setting it locally also turns
# on login for local `mm console`. Share out-of-band, never alongside the URL.
CONSOLE_PASSPHRASE=

# Long random hex used to sign session cookies (e.g. `openssl rand -hex 32`).
# `mm deploy` generates both of these into .env if missing.
MM_SECRET_KEY=

# Optional — lets `mm deploy` run non-interactively (otherwise: fly auth login)
# FLY_API_TOKEN=

# Environment: local (default) | hosted. Set on Fly via `fly secrets set`;
# never set 'hosted' in a laptop .env.
# MM_ENV=local
