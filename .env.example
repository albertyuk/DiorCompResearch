# Maison Monitor — secrets. Copy to .env and fill in. Never commit .env.

# TikHub — create/copy at https://user.tikhub.io → API Keys.
# Note: TikHub shows a key only once, at creation — if you didn't save yours, generate a new one.
TIKHUB_API_KEY=

# Anthropic — https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=

# Optional — model for the filter/match/consolidate/describe calls (this is the default)
# MM_MODEL=claude-sonnet-5
